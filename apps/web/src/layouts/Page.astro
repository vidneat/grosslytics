---
import BaseHead from '../components/seo/BaseHead.astro';
import Logo from '../components/site/Logo.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	/** Compact app chrome (dashboard) instead of the marketing nav and footer */
	app?: boolean;
}

const { title, description, noindex = false, app = false } = Astro.props;
// Set only when building grosslytics.com; buyers' releases are built without PUBLIC_* so they never report here
const ownSiteId = import.meta.env.PUBLIC_OWN_SITE_ID;
const currentSection = (href: string) => !href.includes('#') && Astro.url.pathname.startsWith(href);
const nav = [
	{ href: '/#product', label: 'Product' },
	{ href: '/#pricing', label: 'Pricing' },
	{ href: '/compare/', label: 'Compare' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/docs/', label: 'Docs' },
];
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} noindex={noindex} />
		<slot name="head" />
		{ownSiteId && !app && <script is:inline defer src="/g.js" data-site-id={ownSiteId}></script>}
		<!-- Light unless this browser chose dark; runs before paint so there is no flash -->
		<script is:inline>
			try {
				if (localStorage.getItem('gl_theme') === 'dark') document.documentElement.dataset.theme = 'dark';
			} catch {}
		</script>
	</head>
	<body class="min-h-screen bg-canvas text-ink">
		<header class="sticky top-0 z-50 border-b border-line bg-canvas/80 backdrop-blur-xl backdrop-saturate-150">
			<div class={`mx-auto flex items-center justify-between gap-4 px-5 ${app ? 'h-12 max-w-7xl' : 'h-16 max-w-[1184px]'}`}>
				<Logo />
				{!app && (
					<nav class="hidden items-center gap-6 text-[14px] text-ink-2 lg:flex" aria-label="Main">
						{nav.map((n) => (
							<a href={n.href} aria-current={currentSection(n.href) ? 'page' : undefined} class="whitespace-nowrap transition-colors hover:text-ink aria-[current=page]:text-ink">{n.label}</a>
						))}
					</nav>
				)}
				<div class="flex shrink-0 items-center gap-3 text-[13px]">
					<button id="theme-toggle" type="button" class="rounded-full p-1.5 text-ink-2 hover:bg-band hover:text-ink" aria-label="Switch to dark theme">
						<svg class="theme-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
						<svg class="theme-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
					</button>
					{app ? (
						<a href="/" class="text-ink-2 hover:text-ink">Home</a>
					) : (
						<>
							<a href="https://github.com/vidneat/grosslytics" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-ink ring-1 ring-line hover:bg-band" aria-label="Star Grosslytics on GitHub">
								<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
								<span class="hidden sm:inline">Star</span>
							</a>
							<a href="/app/" class="hidden text-ink-2 hover:text-ink lg:inline">Sign in</a>
							<a href="/start/" class="btn btn-primary hidden !px-4 !py-2 !text-[13px] sm:inline-flex">Get started</a>
                            <details class="mobile-nav lg:hidden">
                                <summary>Menu</summary>
                                <nav aria-label="Mobile main">
                                    {nav.map(n => <a href={n.href} aria-current={currentSection(n.href) ? 'page' : undefined}>{n.label}</a>)}
                                    <a href="/app/">Sign in</a>
                                    <a href="/start/">Get started</a>
                                </nav>
                            </details>
						</>
					)}
				</div>
			</div>
		</header>

		<slot />

		<script is:inline>
			(() => {
				const btn = document.getElementById('theme-toggle');
				const root = document.documentElement;
				const label = () => btn.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
				label();
				btn.addEventListener('click', () => {
					const dark = root.dataset.theme !== 'dark';
					if (dark) root.dataset.theme = 'dark';
					else delete root.dataset.theme;
					try {
						localStorage.setItem('gl_theme', dark ? 'dark' : 'light');
					} catch {}
					label();
				});
			})();
		</script>

		{!app && (
			<footer class="border-t border-line bg-band">
				<div class="mx-auto grid max-w-[1024px] gap-8 px-5 py-12 text-[12px] text-ink-2 sm:grid-cols-4">
					<div class="sm:col-span-1">
						<Logo class="mb-3" />
						<p class="max-w-[22ch] leading-relaxed">Revenue analytics that counts what you keep.</p>
					</div>
					<div>
						<h2 class="mb-2 font-semibold text-ink">Product</h2>
						<ul class="space-y-1.5">
							<li><a class="hover:underline" href="/#product">Overview</a></li>
							<li><a class="hover:underline" href="/#pricing">Pricing</a></li>
							<li><a class="hover:underline" href="/app/demo">Live demo</a></li>
						</ul>
					</div>
					<div>
						<h2 class="mb-2 font-semibold text-ink">Compare</h2>
						<ul class="space-y-1.5">
                            <li><a class="hover:underline" href="/compare/">All comparisons</a></li>
							<li><a class="hover:underline" href="/compare/datafast-alternative/">vs DataFast</a></li>
							<li><a class="hover:underline" href="/compare/databull-alternative/">vs DataBull</a></li>
							<li><a class="hover:underline" href="/compare/plausible-alternative/">vs Plausible</a></li>
							<li><a class="hover:underline" href="/compare/ga4-alternative/">vs Google Analytics</a></li>
						</ul>
					</div>
					<div>
						<h2 class="mb-2 font-semibold text-ink">Developers</h2>
						<ul class="space-y-1.5">
							<li><a class="hover:underline" href="/docs/">Docs</a></li>
                            <li><a class="hover:underline" href="/blog/">Revenue guides</a></li>
							<li><a class="hover:underline" href="/llms.txt">llms.txt</a></li>
							<li><a class="hover:underline" href="/g.js">Tracker (g.js)</a></li>
						</ul>
						<h2 class="mt-5 mb-2 font-semibold text-ink">Legal</h2>
						<ul class="space-y-1.5">
							<li><a class="hover:underline" href="/privacy/">Privacy</a></li>
							<li><a class="hover:underline" href="/terms/">Terms</a></li>
							<li><a class="hover:underline" href="mailto:support@grosslytics.com">support@grosslytics.com</a></li>
						</ul>
					</div>
				</div>
				<div class="mx-auto max-w-[1024px] border-t border-line px-5 py-5 text-[12px] text-ink-3">
					© {new Date().getFullYear()} Grosslytics. No cookies were set on this page.
				</div>
			</footer>
		)}
	</body>
</html>

<style>
    .mobile-nav summary { cursor: pointer; padding: .65rem .75rem; border: 1px solid var(--line); border-radius: .5rem; font-size: .875rem; }
    .mobile-nav[open] summary { background: var(--band); }
    .mobile-nav nav { position: absolute; top: 100%; left: 0; right: 0; padding: .75rem 1.25rem 1.25rem; border-bottom: 1px solid var(--line); background: var(--canvas); box-shadow: 0 12px 20px rgb(0 0 0 / .06); }
    .mobile-nav nav a { display: block; padding: .75rem; font-size: 1rem; border-radius: .375rem; }
    .mobile-nav nav a:hover, .mobile-nav nav a[aria-current='page'] { background: var(--band); color: var(--ink); }
</style>
