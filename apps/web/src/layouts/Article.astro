---
import Page from './Page.astro';
import SchemaJsonLd from '../components/seo/SchemaJsonLd.astro';

const { title, description, pubDate, updatedDate } = Astro.props.frontmatter;
const comparison = Astro.url.pathname.startsWith('/compare/');
const collection = comparison ? { label: 'Comparisons', href: '/compare/' } : { label: 'Blog', href: '/blog/' };
const author = { '@type': 'Person', name: 'David Mill', url: 'https://grosslytics.com/authors/david-mill/', sameAs: ['https://www.linkedin.com/in/david-mill/', 'https://x.com/handancorp'] };
---

<Page title={title} description={description}>
	<SchemaJsonLd slot="head" type="article" title={title} description={description} datePublished={pubDate} dateModified={updatedDate || pubDate} author={author} />
	<main class="article-shell">
		<header class="article-heading">
			<nav class="article-breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a><span aria-hidden="true">/</span><a href={collection.href}>{collection.label}</a>
			</nav>
			<h1>{title}</h1>
			<p class="article-description">{description}</p>
			<div class="article-meta">
				<span>By <a href="/authors/david-mill/">David Mill</a> · Founder, Grosslytics</span>
				{pubDate && <span>Published <time datetime={pubDate}>{pubDate}</time></span>}
				{updatedDate && <span>Updated <time datetime={updatedDate}>{updatedDate}</time></span>}
			</div>
		</header>
		<article class="article-content"><slot /></article>
		<nav class="article-back" aria-label="More articles"><a href={collection.href}>← Explore all {comparison ? 'comparisons' : 'articles'}</a></nav>
	</main>
</Page>

<script>
	// Keep native table semantics and give wide comparisons a named, keyboard-accessible scroll region.
	for (const table of document.querySelectorAll<HTMLTableElement>('.article-content table')) {
		const region = document.createElement('div');
		region.className = 'article-table';
		region.setAttribute('role', 'region');
		region.setAttribute('aria-label', 'Scrollable comparison table');
		region.tabIndex = 0;
		table.before(region);
		region.append(table);
	}
</script>

<style>
	.article-shell { max-width: 1184px; margin: 0 auto; padding: clamp(2.5rem, 4vw, 3.5rem) 1.5rem 5rem; }
	.article-heading { padding-bottom: 1.75rem; border-bottom: 1px solid var(--line); }
	.article-breadcrumb { display: flex; align-items: center; gap: .75rem; margin-bottom: 1.75rem; color: var(--ink-2); font-size: .875rem; }
	.article-breadcrumb a:hover, .article-back a:hover { color: var(--accent); }
	h1 { max-width: 100%; margin: 0; font-size: clamp(2.125rem, 3.8vw, 3rem); line-height: 1.14; font-weight: 650; letter-spacing: -.035em; text-wrap: pretty; }
	.article-description { max-width: 900px; margin-top: 1.5rem; font-size: clamp(1.125rem, 1.65vw, 1.375rem); line-height: 1.65; color: var(--ink-2); letter-spacing: -.015em; }
	.article-meta { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1.75rem; font-size: .875rem; line-height: 1.6; color: var(--ink-2); }
	.article-content { margin-top: 2rem; font-size: 1.125rem; line-height: 1.85; letter-spacing: -.012em; overflow-wrap: break-word; }
	.article-content :global(> p), .article-content :global(> ul), .article-content :global(> ol), .article-content :global(> h2), .article-content :global(> h3), .article-content :global(> blockquote), .article-content :global(> pre) { max-width: 900px; margin-left: 0; margin-right: 0; }
	.article-content :global(> :first-child) { margin-top: 0; }
	.article-content :global(h2) { margin-top: 2.75rem; margin-bottom: 1.25rem; font-size: clamp(1.5rem, 2.5vw, 2rem); line-height: 1.3; font-weight: 650; letter-spacing: -.025em; text-wrap: pretty; scroll-margin-top: 6rem; }
	.article-content :global(h3) { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.25rem; line-height: 1.45; font-weight: 600; text-wrap: pretty; scroll-margin-top: 6rem; }
	.article-content :global(p), .article-content :global(ul), .article-content :global(ol) { margin-top: 1.25rem; margin-bottom: 1.25rem; }
	.article-content :global(li) { padding-left: .3rem; margin: .65rem 0; }
	.article-content :global(ul), .article-content :global(ol) { padding-left: 1.6rem; }
	.article-content :global(ul) { list-style: disc; }
	.article-content :global(ol) { list-style: decimal; }
	.article-content :global(li::marker) { color: var(--ink-2); }
	.article-content :global(a) { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
	.article-content :global(a:hover) { text-decoration-thickness: 2px; }
	.article-content :global(figure) { margin: 3rem 0; }
	.article-content :global(figure img) { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: .75rem; }
	.article-content :global(figcaption) { max-width: 900px; margin: 1rem 0 0; font-size: .875rem; line-height: 1.7; color: var(--ink-2); }
	.article-content :global(pre) { overflow-x: auto; margin-top: 1.75rem; margin-bottom: 1.75rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: .5rem; background: var(--band); font-size: .9rem; line-height: 1.75; letter-spacing: normal; }
	.article-content :global(:not(pre) > code) { padding: .15em .35em; border-radius: .25rem; background: var(--band); font-size: .85em; overflow-wrap: anywhere; }
	.article-content :global(blockquote) { padding: 1rem 1.5rem; border-left: 2px solid var(--line); color: var(--ink-2); }
	.article-content :global(table) { display: block; width: 100%; overflow-x: auto; margin: 2.5rem 0; border-collapse: collapse; font-size: .9375rem; line-height: 1.7; letter-spacing: normal; }
	.article-content :global(.article-table) { overflow-x: auto; margin: 2.5rem 0; border: 1px solid var(--line); border-radius: .5rem; }
	.article-content :global(.article-table table) { display: table; overflow: visible; margin: 0; }
	.article-content :global(th), .article-content :global(td) { min-width: 10rem; padding: 1.25rem 1.375rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
	.article-content :global(th) { background: var(--band); font-weight: 600; color: var(--ink); }
	.article-content :global(td + td), .article-content :global(th + th) { border-left: 1px solid var(--line); }
	.article-content :global(tbody tr:last-child td) { border-bottom: 0; }
	.article-content :global(tbody tr:nth-child(even)) { background: color-mix(in srgb, var(--band) 45%, var(--canvas)); }
	.article-back { max-width: 900px; margin: 3rem 0 0; padding-top: 1.75rem; border-top: 1px solid var(--line); font-size: 1rem; }
	@media (max-width: 639px) {
		.article-shell { padding: 2rem 1.25rem 3rem; }
		h1 { font-size: 2.125rem; line-height: 1.18; }
		.article-content { font-size: 1.0625rem; line-height: 1.8; }
		.article-content :global(h2) { margin-top: 2.75rem; }
		.article-content :global(figure) { margin: 2rem 0; }
		.article-content :global(pre) { padding: 1rem; }
		.article-content :global(th), .article-content :global(td) { min-width: 11rem; padding: 1rem; }
	}
</style>
