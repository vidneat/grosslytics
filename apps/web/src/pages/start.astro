---
import Page from '../layouts/Page.astro';
import Onboarding from '../components/onboarding/Onboarding.tsx';
---

<Page title="Get started — Grosslytics" description="Set up Grosslytics on your own Cloudflare account: deploy, add the tracker, connect payments. Each step checks itself.">
	<main class="bg-canvas px-5 pt-16 pb-24">
		<div class="mx-auto max-w-[760px]">
			<header class="mb-10 text-center">
				<h1 class="text-[clamp(36px,5vw,56px)] font-semibold leading-[1.05] tracking-[-0.035em]">Get started.</h1>
				<p class="mt-3 text-[19px] text-ink-2">Four steps. Each one checks itself, so you know it worked.</p>
			</header>
			<Onboarding client:load />
		</div>
	</main>
</Page>
