---
import Page from '../../../layouts/Page.astro';
import type { MarkdownInstance } from 'astro';

const articles = Object.values(import.meta.glob<MarkdownInstance<{ title: string; description: string }>>(['../../blog/*.md', '../../compare/*.md'], { eager: true }))
	.sort((a, b) => a.frontmatter.title.localeCompare(b.frontmatter.title));
const profile = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'David Mill',
	jobTitle: 'Founder',
	worksFor: { '@type': 'Organization', name: 'Grosslytics', url: 'https://grosslytics.com' },
	url: 'https://grosslytics.com/authors/david-mill/',
	sameAs: ['https://www.linkedin.com/in/david-mill/', 'https://x.com/handancorp'],
};
---

<Page title="David Mill, Founder of Grosslytics" description="David Mill is the founder of Grosslytics. Find his revenue attribution and analytics implementation guides.">
	<script type="application/ld+json" set:html={JSON.stringify(profile)} slot="head" />
	<main class="mx-auto max-w-3xl px-5 py-16">
		<p class="text-sm text-ink-2"><a href="/blog/" class="underline">Blog</a> / Author</p>
		<h1 class="mt-5 text-4xl font-semibold tracking-tight">David Mill</h1>
		<p class="mt-3 text-lg text-ink-2">Founder of Grosslytics</p>
		<p class="mt-6 leading-7">David Mill is the founder of Grosslytics. The articles below cover revenue attribution, analytics implementation and comparisons, including product capabilities, source documentation, and known limitations.</p>
		<ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
			<li><a class="underline" href="https://www.linkedin.com/in/david-mill/" rel="me">LinkedIn profile</a></li>
			<li><a class="underline" href="https://x.com/handancorp" rel="me">X profile (@handancorp)</a></li>
		</ul>
		<h2 class="mt-12 text-2xl font-semibold">Articles</h2>
		<ul class="mt-4">
			{articles.map(article => <li class="border-b border-line py-5">
				<h3 class="text-lg font-medium"><a class="underline" href={article.url}>{article.frontmatter.title}</a></h3>
				<p class="mt-2 text-ink-2">{article.frontmatter.description}</p>
			</li>)}
		</ul>
	</main>
</Page>
