---
import Page from '../../layouts/Page.astro';
import DashboardIsland from '../../components/dashboard/DashboardIsland.tsx';

export const prerender = false;

const domain = Astro.params.domain || 'shipfast.io';
const badgePath = `/badge/${encodeURIComponent(domain)}.svg`;
---

<Page
	title={`${domain} — Verified Revenue on Grosslytics`}
	description={`Live revenue, net profit and channel attribution for ${domain}, verified by Grosslytics.`}
>
	<main class="bg-band px-5 pt-16 pb-24">
		<div class="mx-auto max-w-[1100px]">
			<header class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<p class="eyebrow mb-2">Public revenue page</p>
					<h1 class="text-[clamp(36px,5vw,56px)] font-semibold leading-none tracking-[-0.035em]">{domain}</h1>
					<p class="mt-3 text-ink-2">Revenue verified directly from the payment provider.</p>
				</div>

				<div class="flex items-center gap-3 rounded-2xl bg-card p-3 ring-1 ring-line">
					<img src={badgePath} alt="Verified net profit badge" width="210" height="32" class="h-8 w-auto" />
					<button
						type="button"
						class="btn btn-quiet !px-3 !py-1.5 !text-[13px]"
						data-copy-badge={`<img src="https://grosslytics.com${badgePath}" alt="Verified Net Profit"/>`}
					>
						Copy embed
					</button>
				</div>
			</header>

			<DashboardIsland client:visible site={domain} />

			<p class="mt-6 text-center text-[13px] text-ink-3">
				Want a page like this? <a href="/#pricing" class="text-accent hover:underline">Track your startup with Grosslytics ›</a>
			</p>
		</div>
	</main>

	<!-- Copy via data attribute: untrusted `domain` never reaches inline JS -->
	<script>
		for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy-badge]')) {
			b.addEventListener('click', async () => {
				await navigator.clipboard.writeText(b.dataset.copyBadge || '');
				b.textContent = 'Copied';
				setTimeout(() => (b.textContent = 'Copy embed'), 1500);
			});
		}
	</script>
</Page>
