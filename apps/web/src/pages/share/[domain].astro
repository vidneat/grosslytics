---
import BaseHead from '../../components/seo/BaseHead.astro';
import DashboardIsland from '../../components/dashboard/DashboardIsland.tsx';
import '../../styles/global.css';

export const prerender = false;

const domain = Astro.params.domain || 'shipfast.io';
const siteTitle = `${domain} — Verified Net MRR & Attribution`;
const description = `Live verified revenue, net profit, and attribution analytics for ${domain} powered by Grosslytics.`;
---

<html lang="en">
	<head>
		<BaseHead title={siteTitle} description={description} />
	</head>
	<body class="bg-zinc-950 text-zinc-100 min-h-screen selection:bg-emerald-500 selection:text-black">
		<header class="border-b border-zinc-800/80 sticky top-0 bg-zinc-950/80 backdrop-blur-md z-50">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
				<a href="/" class="flex items-center gap-2">
					<span class="w-7 h-7 rounded-lg bg-emerald-500 flex items-center justify-center font-black text-black text-base">G</span>
					<span class="font-bold text-lg tracking-tight text-white">Grosslytics</span>
				</a>
				<div class="flex items-center gap-3">
					<span class="text-xs text-zinc-500 font-mono hidden sm:inline">Public Verified Dashboard</span>
					<a
						href="/app"
						class="text-xs font-semibold px-4 py-2 rounded-lg bg-emerald-500 text-black hover:bg-emerald-400"
					>
						Track Your Startup
					</a>
				</div>
			</div>
		</header>

		<main class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 pb-24">
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
				<div>
					<div class="flex items-center gap-2 mb-2">
						<span class="text-xs font-semibold uppercase tracking-wider text-emerald-400 font-mono bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">
							Verified Revenue
						</span>
						<span class="text-xs text-zinc-500 font-mono">100% Stripe Verified</span>
					</div>
					<h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">{domain}</h1>
				</div>

				<!-- Embed Badge Widget Snippet -->
				<div class="bg-zinc-900 border border-zinc-800 p-3 rounded-xl flex items-center gap-3">
					<img src={`/badge/${domain}.svg`} alt="Verified Net Profit" class="h-8" />
					<button
						class="text-xs font-mono text-zinc-400 hover:text-white px-2 py-1 bg-zinc-800 rounded border border-zinc-700 transition-colors"
						onclick={`navigator.clipboard.writeText('<img src="https://grosslytics.com/badge/${domain}.svg" alt="Verified Net Profit"/>')`}
					>
						Copy Badge SVG
					</button>
				</div>
			</div>

			<!-- Server Island with Deferred Hydration -->
			<DashboardIsland client:visible />
		</main>
	</body>
</html>

