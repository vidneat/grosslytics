---
import Page from '../../layouts/Page.astro';
import DashboardIsland from '../../components/dashboard/DashboardIsland.tsx';

export const prerender = false;
---

<Page title="Grosslytics Workspace" description="Real-time revenue attribution workspace." noindex app>
	<main class="min-h-[calc(100vh-3rem)] bg-band px-5 py-8">
		<div class="mx-auto max-w-7xl">
			<h1 class="mb-6 text-[28px] font-semibold tracking-[-0.025em]">Overview</h1>
			<DashboardIsland client:only="react" />
		</div>
	</main>
</Page>
