---
import Page from '../../layouts/Page.astro';
import DashboardIsland from '../../components/dashboard/DashboardIsland.tsx';

export const prerender = false;

// /app/demo is the full sample workspace; every other /app path is the owner's live dashboard.
const demo = Astro.params.slug === 'demo';
---

<Page title={demo ? 'Grosslytics Demo Workspace' : 'Grosslytics Workspace'} description="Real-time revenue attribution workspace." noindex app>
	<main class="min-h-[calc(100vh-3rem)] bg-canvas pb-12">
		<h1 class="sr-only">{demo ? 'Demo workspace' : 'Workspace'}</h1>
		{demo ? <DashboardIsland client:only="react" source="demo" /> : <DashboardIsland client:only="react" source="api" />}
		<p class="mx-auto mt-10 max-w-7xl px-5 text-center text-[13px]">
			{demo ? <a href="/app/" class="text-accent hover:underline">This is sample data. Connect your own ›</a> : <a href="/app/demo" class="text-ink-2 hover:underline">View sample data</a>}
		</p>
	</main>
</Page>
