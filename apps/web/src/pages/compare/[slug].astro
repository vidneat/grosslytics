---
import Page from '../../layouts/Page.astro';
import SchemaJsonLd from '../../components/seo/SchemaJsonLd.astro';
import RoiCalculator from '../../components/marketing/RoiCalculator.tsx';

export const prerender = true;

/*
 * Every competitor fact below comes from the competitor's own public website, checked on VERIFIED.
 * Tracker sizes were measured by downloading each script and compressing it with Brotli (quality 11),
 * the same way packages/tracker/build.ts measures g.js. Re-check before changing any claim.
 */
export function getStaticPaths() {
	// getStaticPaths runs in isolation, so its constants live inside it
	const VERIFIED = '2026-11-06';
	const US = {
		tracker: '1.3 KB',
		price: '$0 self-hosted, $5/mo hosted, or $29 lifetime',
		gateways: 'Stripe, Razorpay, Polar, Paddle, Lemon Squeezy',
		fees: 'Deducted automatically per gateway',
		cookies: 'No cookies; a random visitor ID in localStorage',
	};

	return [
		{
			params: { slug: 'datafast-alternative' },
			props: {
				competitor: 'DataFast',
				competitorDomain: 'datafa.st',
				title: 'DataFast Alternative with Net Revenue | Grosslytics',
				description: 'DataFast and Grosslytics both tie revenue to marketing channels. Grosslytics adds Razorpay and Paddle, subtracts gateway fees, and can run on your own Cloudflare account.',
				rows: [
					['Tracker size (Brotli)', '4.5 KB', US.tracker],
					['Price', 'From $9/mo (Starter, 10k events, 1 site); Growth from $19/mo', US.price],
					['Payment providers', 'Stripe, Lemon Squeezy, Polar, Shopify, plus a Payment API', US.gateways],
					['Gateway fees', 'Not mentioned on datafa.st', US.fees],
					['Self-hosting', 'Not offered on datafa.st', 'Yes, on your Cloudflare account'],
					['MCP server', 'Yes (API, CLI and MCP)', 'Yes'],
					['Cookies', 'Cookies by default; a cookieless script is available', US.cookies],
				],
				theyLead: ['Shopify integration and a Payment API', 'Social mentions (X and Reddit) and link attribution on Growth', 'A mature hosted product with many users'],
				weDiffer: ['Razorpay and Paddle support', 'Net revenue after gateway fees', 'Self-host for $0 on your own Cloudflare account', 'A smaller tracker (1.3 KB vs 4.5 KB)'],
				verified: VERIFIED,
				sources: [{ label: 'datafa.st (features, pricing, FAQ)', url: 'https://datafa.st' }, { label: 'datafa.st/js/script.js (measured)', url: 'https://datafa.st/js/script.js' }],
			},
		},
		{
			params: { slug: 'databull-alternative' },
			props: {
				competitor: 'DataBull',
				competitorDomain: 'databull.app',
				title: 'DataBull Alternative with Net Revenue | Grosslytics',
				description: 'DataBull and Grosslytics both run on Cloudflare and attribute revenue to channels. Grosslytics adds Razorpay, Paddle and Lemon Squeezy and reports revenue after gateway fees.',
				rows: [
					['Tracker size (Brotli)', '6.4 KB', US.tracker],
					['Price', '$49 once (self-hosted); hosted from $9/mo (beta)', US.price],
					['Payment providers', 'Stripe, Polar, Dodo, Creem', US.gateways],
					['Gateway fees', 'Not mentioned on databull.app', US.fees],
					['Self-hosting', 'Yes, Cloudflare Workers + D1', 'Yes, Cloudflare Workers + D1'],
					['MCP server', 'Built in', 'Built in'],
					['In-app browser detection', 'Yes ("Readable Direct")', 'Yes'],
					['Past payments', 'Imported on day one', 'Not yet; attribution starts when you install'],
				],
				theyLead: ['Dodo and Creem support', 'Imports past payments on day one', 'A more mature product with alerts and lifetime-value reports'],
				weDiffer: ['Razorpay, Paddle and Lemon Squeezy support', 'Net revenue after gateway fees', 'A $0 self-hosted tier', 'A smaller tracker (1.3 KB vs 6.4 KB)'],
				verified: VERIFIED,
				sources: [{ label: 'databull.app (features, pricing, FAQ)', url: 'https://databull.app' }, { label: 'databull.app/js/script.js (measured)', url: 'https://databull.app/js/script.js' }],
			},
		},
		{
			params: { slug: 'plausible-alternative' },
			props: {
				competitor: 'Plausible',
				competitorDomain: 'plausible.io',
				title: 'Plausible Alternative with Revenue Attribution | Grosslytics',
				description: 'Plausible is lightweight, private web analytics. Grosslytics adds payment-provider revenue attribution: which channel each sale came from, and what you kept after fees.',
				rows: [
					['Tracker size (Brotli)', '1.1 KB', US.tracker],
					['Price', 'From $9/mo (Starter, 10k pageviews, 1 site)', US.price],
					['Revenue', 'Revenue tracking through custom events', 'Payment webhooks credit each sale to a channel'],
					['Payment providers', 'No integrations listed', US.gateways],
					['Gateway fees', 'Not mentioned on plausible.io', US.fees],
					['Cookies', 'No cookies', US.cookies],
					['Open source', 'Yes', 'No'],
				],
				theyLead: ['A smaller tracker (1.1 KB vs 1.3 KB)', 'Open source and hosted in the EU', 'Funnels, Google Analytics import and a long track record'],
				weDiffer: ['Sales attributed from Stripe, Razorpay, Polar, Paddle and Lemon Squeezy', 'First-touch, last-touch and linear attribution', 'Net revenue after gateway fees'],
				verified: VERIFIED,
				sources: [{ label: 'plausible.io (features and pricing)', url: 'https://plausible.io' }, { label: 'plausible.io/js/script.js (measured)', url: 'https://plausible.io/js/script.js' }],
			},
		},
		{
			params: { slug: 'ga4-alternative' },
			props: {
				competitor: 'Google Analytics 4',
				competitorDomain: 'analytics.google.com',
				title: 'Lightweight GA4 Alternative with Revenue | Grosslytics',
				description: 'Google Analytics 4 is free and deep, but heavy. Grosslytics is a 1.3 KB tracker that credits each payment to the channel that brought the buyer.',
				rows: [
					['Tracker size (Brotli)', '125 KB (gtag.js)', US.tracker],
					['Price', 'Free', US.price],
					['Revenue', 'Ecommerce events you send yourself', 'Payment webhooks credit each sale to a channel'],
					['Gateway fees', 'Not handled', US.fees],
					['Cookies', 'Uses cookies', US.cookies],
				],
				theyLead: ['Free, with very deep reporting', 'Google Ads and Search Console integration', 'Industry-standard tooling and support'],
				weDiffer: ['About 1% of the tracker weight', 'No cookies', 'Sales from your payment provider, credited to channels without custom event code'],
				verified: VERIFIED,
				sources: [{ label: 'googletagmanager.com/gtag/js (measured)', url: 'https://www.googletagmanager.com/gtag/js' }],
			},
		},
	];
}

const { competitor, competitorDomain, title, description, rows, theyLead, weDiffer, sources, verified: lastVerifiedDate } = Astro.props;

const faqs = [
	{
		question: `How does Grosslytics differ from ${competitor}?`,
		answer: `${weDiffer.join('. ')}. Where ${competitor} is ahead: ${theyLead.join('; ')}.`,
	},
	{
		question: `Can I bring my history over from ${competitor}?`,
		answer: 'Not yet. Grosslytics starts attributing visits and sales from the day you add the tracker. Importing past Stripe payments is planned.',
	},
	{
		question: 'Does Grosslytics use cookies?',
		answer: 'No. The tracker stores a random visitor ID in localStorage so it can connect a later purchase to the first visit. Some privacy laws treat that like a cookie, so check whether your site needs consent.',
	},
];
---

<Page title={title} description={description}>
	<Fragment slot="head">
		<SchemaJsonLd
			type="article"
			title={title}
			description={description}
			datePublished="2025-01-01"
			dateModified={lastVerifiedDate}
		/>
		<SchemaJsonLd type="faq" faqs={faqs} />
	</Fragment>

	<main>
		<article class="mx-auto max-w-[760px] px-5 pt-14 pb-20">
			<nav aria-label="Breadcrumb" class="mb-10 text-[13px] text-ink-3">
				<ol class="flex items-center gap-2">
					<li><a href="/" class="hover:text-ink">Home</a></li>
					<li aria-hidden="true">›</li>
					<li>Compare</li>
					<li aria-hidden="true">›</li>
					<li class="text-ink-2" aria-current="page">{competitor} alternative</li>
				</ol>
			</nav>

			<header>
				<p class="eyebrow mb-3">Grosslytics vs {competitor}</p>
				<h1 class="text-[clamp(36px,5.5vw,56px)] font-semibold leading-[1.06] tracking-[-0.035em]">
					The {competitor} alternative that counts what you keep.
				</h1>
				<p class="mt-5 text-[21px] leading-relaxed text-ink-2">{description}</p>
				<p class="mt-6 text-[13px] text-ink-3">
					By the Grosslytics team · <time datetime={lastVerifiedDate}>Last verified {lastVerifiedDate}</time> · Checked against <span class="text-ink-2">{competitorDomain}</span>
				</p>
			</header>

			<section class="mt-16">
				<h2 class="text-[28px] font-semibold tracking-[-0.02em]">At a glance</h2>
				<div class="mt-6 overflow-x-auto rounded-[20px] ring-1 ring-line">
					<table class="w-full min-w-[520px] text-left text-[15px]">
						<thead>
							<tr class="bg-band text-[13px] text-ink-2">
								<th scope="col" class="px-5 py-3 font-medium">Capability</th>
								<th scope="col" class="px-5 py-3 font-medium">{competitor}</th>
								<th scope="col" class="px-5 py-3 font-semibold text-ink">Grosslytics</th>
							</tr>
						</thead>
						<tbody>
							{rows.map(([cap, them, us]) => (
								<tr class="border-t border-line">
									<th scope="row" class="px-5 py-3.5 font-normal text-ink-2">{cap}</th>
									<td class="px-5 py-3.5 text-ink-2">{them}</td>
									<td class="px-5 py-3.5 font-medium">{us}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="mt-4 text-[13px] leading-relaxed text-ink-3">
					{competitor} details are from their public website, checked {lastVerifiedDate}. Tracker sizes were measured by compressing each script with Brotli. Sources:
					{sources.map((src, i) => <>{i > 0 && ', '}<a class="underline decoration-ink-3/40 hover:text-ink-2" href={src.url} rel="nofollow noopener" target="_blank">{src.label}</a></>)}.				</p>
			</section>
		</article>

		<section class="bg-band px-5 py-20">
			<h2 class="mx-auto mb-10 max-w-[760px] text-center text-[28px] font-semibold tracking-[-0.02em]">Cost and margin calculator</h2>
			<RoiCalculator client:visible />
		</section>

		<article class="mx-auto max-w-[760px] px-5 py-20">
			<section class="grid gap-4 sm:grid-cols-2">
				<div class="rounded-[24px] bg-band p-7">
					<h2 class="text-[21px] font-semibold tracking-[-0.02em]">Where Grosslytics differs</h2>
					<ul class="mt-4 space-y-2.5 text-[17px] text-ink-2">
						{weDiffer.map((f) => <li class="flex gap-3"><span class="text-accent" aria-hidden="true">•</span>{f}</li>)}
					</ul>
				</div>
				<div class="rounded-[24px] bg-band p-7">
					<h2 class="text-[21px] font-semibold tracking-[-0.02em]">Where {competitor} is ahead</h2>
					<ul class="mt-4 space-y-2.5 text-[17px] text-ink-2">
						{theyLead.map((f) => <li class="flex gap-3"><span class="text-ink-3" aria-hidden="true">•</span>{f}</li>)}
					</ul>
				</div>
			</section>

			<section class="prose-g mt-16 text-[19px] leading-relaxed">
				<h2 class="text-[28px] font-semibold tracking-[-0.02em] text-ink">Why net revenue matters</h2>
				<p>
					Payment providers keep a cut of every sale: Stripe's standard US card rate is 2.9% + 30¢, and merchant-of-record platforms take more. Add ad spend, and a channel with $10,000 in sales, $8,000 in ads and $450 in fees made you <strong>$1,550</strong>.
				</p>
				<p>
					Grosslytics ranks channels by <strong>revenue per visitor</strong> after those costs, so you can see which ones actually pay.
				</p>
			</section>

			<section class="mt-16 border-t border-line pt-12">
				<h2 class="text-[28px] font-semibold tracking-[-0.02em]">Questions</h2>
				<div class="mt-4 divide-y divide-line">
					{faqs.map((faq) => (
						<details class="group py-5">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[17px] font-semibold">
								<h3>{faq.question}</h3>
								<span class="text-[22px] font-light text-ink-3 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
							</summary>
							<p class="mt-3 text-[17px] leading-relaxed text-ink-2">{faq.answer}</p>
						</details>
					))}
				</div>
			</section>

			<div class="mt-16 rounded-[28px] bg-band p-10 text-center">
				<h2 class="text-[28px] font-semibold tracking-[-0.02em]">See your own numbers.</h2>
				<p class="mt-2 text-ink-2">Free on your Cloudflare account.</p>
				<div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
					<a href="/#pricing" class="btn btn-primary">Start free</a>
					<a href="/app/demo" class="btn-quiet text-[17px]">Explore the live demo ›</a>
				</div>
			</div>
		</article>
	</main>
</Page>
