---
import Page from '../../layouts/Page.astro';
import SchemaJsonLd from '../../components/seo/SchemaJsonLd.astro';
import RoiCalculator from '../../components/marketing/RoiCalculator.tsx';

export const prerender = true;

/*
 * Every competitor fact below comes from the competitor's own public website (or Google's help center for GA4),
 * checked on VERIFIED. Tracker sizes were measured by downloading each script and compressing it with Brotli
 * (quality 11), the same way packages/tracker/build.ts measures g.js. Re-check before changing any claim.
 * Each page targets one keyword cluster: `keyword` is the primary term; headings and FAQs carry the long tail.
 */
export function getStaticPaths() {
	// getStaticPaths runs in isolation, so its constants live inside it
	const VERIFIED = '2026-11-07';
	const US = {
		tracker: '1.5 KB',
		price: '$0 self-hosted (open source); hosted $5.99/mo; $29 Lifetime with installer, support and commercial license',
		gateways: 'Stripe, Razorpay, Polar, Paddle, Lemon Squeezy, Dodo Payments, Cashfree, Gumroad, PayPal, RevenueCat',
		fees: 'Deducted automatically per gateway',
		cookies: 'No cookies; a random visitor ID in localStorage',
	};
	const switchSteps = (them: string, extra?: string) => [
		`Deploy Grosslytics to your Cloudflare account from /start. The setup checks each step against real data, so you know when it works.`,
		`Replace the ${them} script tag with the Grosslytics one. You can run both side by side for a week to compare numbers before removing ${them}.`,
		'Add one webhook URL in your payment provider (Stripe, Razorpay, Polar, Paddle or Lemon Squeezy). New sales are matched to the visitor who made them.',
		extra ?? 'Add a data-goal attribute to any button you want counted in the “Reached a goal” step.',
	];

	return [
		{
			params: { slug: 'ga4-alternative' },
			props: {
				competitor: 'Google Analytics 4',
				competitorDomain: 'analytics.google.com',
				keyword: 'GA4 alternative',
				title: 'GA4 Alternative for SaaS: 1.5 KB, Cookie-Free, Revenue',
				description: 'A lightweight GA4 alternative for SaaS founders: a 1.5 KB cookie-free script that credits each Stripe or Paddle sale to the channel that brought it.',
				h1: 'The lightweight GA4 alternative that follows the money.',
				answer: 'Google Analytics 4 is free and very deep, but its script is about 125 KB, it uses cookies, and revenue only appears if you send ecommerce events yourself. Grosslytics is a 1.5 KB, cookie-free tracker that receives your payment webhooks and shows which channel brought each paying customer, after fees. Keep GA4 if you rely on Google Ads and Search Console integration; switch if you want a one-page answer to “which channels make money?”',
				whatIs: 'Google Analytics 4 is Google’s free web and app analytics. It is event-based, integrates with Google Ads, Search Console and BigQuery, and offers explorations, audiences and multiple attribution settings. It uses cookies, so many regions need a consent banner. User-level data in standard properties is kept for 2 or 14 months, set by you.',
				rows: [
					['Tracker size (Brotli)', '125 KB (gtag.js)', US.tracker],
					['Price', 'Free', US.price],
					['Revenue', 'Ecommerce events you send yourself', 'Payment webhooks credit each sale to a channel'],
					['Gateway fees', 'Not handled', US.fees],
					['Setup', 'Tag, events, conversions and reports to configure', 'One script tag and one webhook URL'],
					['User-level data retention', '2 or 14 months (standard properties)', 'As long as you keep it in your own database'],
					['Cookies', 'Uses cookies', US.cookies],
					['Google Ads and Search Console', 'Built in', 'Not integrated'],
				],
				chooseThem: ['You buy Google Ads and need conversion data sent back to Google', 'You need Search Console, BigQuery export or audiences', 'You have an analyst who uses explorations and custom reports'],
				chooseUs: ['You want one page that ranks channels by revenue', 'You want a script 1% of the size and no cookies', 'You do not want to write ecommerce event code', 'You are a SaaS or indie founder paid through Stripe, Razorpay, Polar, Paddle or Lemon Squeezy'],
				pricing: [
					'Google Analytics 4 is free; Google Analytics 360 is the paid enterprise tier. The cost is in setup time: tags, events, key events and reports, and keeping consent rules right.',
					'Grosslytics self-hosted is $0 on your own Cloudflare account. Hosted plans are offered from /start.',
				],
				deep: [
					{
						h2: 'Why revenue is hard in GA4',
						ps: [
							'GA4 knows about a purchase only if your site sends a purchase event with the value, usually from a thank-you page. Subscription renewals, refunds and payment fees happen at your payment provider, not on your site, so GA4 never sees them unless you build that pipeline yourself.',
							'Grosslytics starts from the payment side. Each signed webhook from your provider is matched to the visitor who checked out, so renewals stay credited to the channel that found the customer, full Stripe refunds drop out of revenue, and fees are subtracted automatically.',
						],
					},
					{
						h2: 'Speed and consent',
						ps: [
							'At about 125 KB compressed, gtag.js is roughly 80 times the size of the Grosslytics tracker. And because GA4 uses cookies, sites with visitors in the EU and UK usually need a consent banner, and visitors who decline are missing from the data. Grosslytics sets no cookies; it does keep a random visitor ID in localStorage, so check your local rules.',
						],
					},
				],
				switching: switchSteps('GA4', 'Add data-goal attributes to the buttons behind the GA4 key events you care about; they count toward the “Reached a goal” step. Keep GA4 running if you still need its Google Ads integration.'),
				faqs: [
					{ question: 'What is the best Google Analytics alternative for SaaS?', answer: 'For SaaS founders who want revenue by channel, a revenue-first tool like Grosslytics answers that directly. For private traffic analytics only, Plausible or Fathom. For product analytics with session replay, PostHog.' },
					{ question: 'Is there a free Google Analytics alternative?', answer: 'Yes. Grosslytics is free to self-host on your own Cloudflare account, and some open-source tools such as Umami and Matomo can be self-hosted for free too.' },
					{ question: 'Can Grosslytics replace GA4 completely?', answer: 'For traffic sources, pages, countries, devices and revenue attribution, yes. It does not replace Google Ads conversion import, Search Console data or BigQuery export, so keep GA4 if you depend on those.' },
					{ question: 'Does Grosslytics need a cookie banner?', answer: 'It sets no cookies and stores no IP addresses. It keeps a random visitor ID in localStorage to connect purchases to visits; some privacy laws treat that like a cookie, so check what your visitors’ region requires.' },
					{ question: 'How long does Grosslytics keep data?', answer: 'Data lives in the D1 database in your own Cloudflare account and stays until you delete it. GA4 standard properties keep user-level data for 2 or 14 months.' },
				],
				theyLead: ['Free, with very deep reporting', 'Google Ads and Search Console integration', 'Industry-standard tooling and support'],
				weDiffer: ['About 1% of the tracker weight', 'No cookies', 'Sales from your payment provider, credited to channels without custom event code'],
				verified: VERIFIED,
				sources: [{ label: 'googletagmanager.com/gtag/js (measured)', url: 'https://www.googletagmanager.com/gtag/js' }, { label: 'GA4 data retention (Google help)', url: 'https://support.google.com/analytics/answer/7667196' }],
			},
		},
	];
}

const { competitor, competitorDomain, title, description, h1, answer, whatIs, rows, chooseThem, chooseUs, pricing, deep, switching, faqs, theyLead, weDiffer, sources, verified: lastVerifiedDate } = Astro.props;
const related = [
	{ href: '/compare/datafast-alternative/', name: 'DataFast' },
	{ href: '/compare/databull-alternative/', name: 'DataBull' },
	{ href: '/compare/plausible-alternative/', name: 'Plausible' },
	{ href: '/compare/ga4-alternative/', name: 'Google Analytics 4' },
].filter((r) => r.name !== competitor);
const h2 = 'text-[28px] font-semibold tracking-[-0.02em] text-ink';
---

<Page title={title} description={description}>
	<Fragment slot="head">
		<SchemaJsonLd
			type="article"
			title={title}
			description={description}
			datePublished="2026-11-06"
			dateModified={lastVerifiedDate}
		/>
		<SchemaJsonLd type="faq" faqs={faqs} />
	</Fragment>

	<main>
		<article class="mx-auto max-w-[760px] px-5 pt-14 pb-20">
			<nav aria-label="Breadcrumb" class="mb-10 text-[13px] text-ink-3">
				<ol class="flex items-center gap-2">
					<li><a href="/" class="hover:text-ink">Home</a></li>
					<li aria-hidden="true">›</li>
					<li>Compare</li>
					<li aria-hidden="true">›</li>
					<li class="text-ink-2" aria-current="page">{competitor} alternative</li>
				</ol>
			</nav>

			<header>
				<p class="eyebrow mb-3">Grosslytics vs {competitor}</p>
				<h1 class="text-[clamp(36px,5.5vw,56px)] font-semibold leading-[1.06] tracking-[-0.035em]">{h1}</h1>
				<p class="mt-5 text-[21px] leading-relaxed text-ink-2">{answer}</p>
				<p class="mt-6 text-[13px] text-ink-3">
					By the Grosslytics team · <time datetime={lastVerifiedDate}>Last verified {lastVerifiedDate}</time> · Checked against <span class="text-ink-2">{competitorDomain}</span>
				</p>
			</header>

			<section class="prose-g mt-14 text-[19px] leading-relaxed">
				<h2 class={h2}>What is {competitor}?</h2>
				<p>{whatIs}</p>
			</section>

			<section class="mt-14">
				<h2 class={h2}>{competitor} vs Grosslytics at a glance</h2>
				<div class="mt-6 overflow-x-auto rounded-[20px] ring-1 ring-line">
					<table class="w-full min-w-[520px] text-left text-[15px]">
						<thead>
							<tr class="bg-band text-[13px] text-ink-2">
								<th scope="col" class="px-5 py-3 font-medium">Capability</th>
								<th scope="col" class="px-5 py-3 font-medium">{competitor}</th>
								<th scope="col" class="px-5 py-3 font-semibold text-ink">Grosslytics</th>
							</tr>
						</thead>
						<tbody>
							{rows.map(([cap, them, us]) => (
								<tr class="border-t border-line">
									<th scope="row" class="px-5 py-3.5 font-normal text-ink-2">{cap}</th>
									<td class="px-5 py-3.5 text-ink-2">{them}</td>
									<td class="px-5 py-3.5 font-medium">{us}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="mt-4 text-[13px] leading-relaxed text-ink-3">
					{competitor} details are from their public website, checked {lastVerifiedDate}. Tracker sizes were measured by compressing each script with Brotli. Sources:
					{sources.map((src, i) => <>{i > 0 && ', '}<a class="underline decoration-ink-3/40 hover:text-ink-2" href={src.url} rel="nofollow noopener" target="_blank">{src.label}</a></>)}.
				</p>
			</section>

			<section class="mt-14 grid gap-4 sm:grid-cols-2">
				<div class="rounded-[24px] bg-band p-7">
					<h2 class="text-[21px] font-semibold tracking-[-0.02em]">Choose {competitor} if</h2>
					<ul class="mt-4 space-y-2.5 text-[17px] text-ink-2">
						{chooseThem.map((f) => <li class="flex gap-3"><span class="text-ink-3" aria-hidden="true">•</span>{f}</li>)}
					</ul>
				</div>
				<div class="rounded-[24px] bg-band p-7">
					<h2 class="text-[21px] font-semibold tracking-[-0.02em]">Choose Grosslytics if</h2>
					<ul class="mt-4 space-y-2.5 text-[17px] text-ink-2">
						{chooseUs.map((f) => <li class="flex gap-3"><span class="text-accent" aria-hidden="true">•</span>{f}</li>)}
					</ul>
				</div>
			</section>

			<section class="prose-g mt-14 text-[19px] leading-relaxed">
				<h2 class={h2}>{competitor} pricing vs Grosslytics pricing</h2>
				{pricing.map((p) => <p>{p}</p>)}
			</section>

			{deep.map((s) => (
				<section class="prose-g mt-14 text-[19px] leading-relaxed">
					<h2 class={h2}>{s.h2}</h2>
					{s.ps.map((p) => <p>{p}</p>)}
				</section>
			))}
		</article>

		<section class="bg-band px-5 py-20">
			<h2 class="mx-auto mb-10 max-w-[760px] text-center text-[28px] font-semibold tracking-[-0.02em]">Cost and margin calculator</h2>
			<RoiCalculator client:visible />
		</section>

		<article class="mx-auto max-w-[760px] px-5 py-20">
			<section class="grid gap-4 sm:grid-cols-2">
				<div class="rounded-[24px] bg-band p-7">
					<h2 class="text-[21px] font-semibold tracking-[-0.02em]">Where Grosslytics differs</h2>
					<ul class="mt-4 space-y-2.5 text-[17px] text-ink-2">
						{weDiffer.map((f) => <li class="flex gap-3"><span class="text-accent" aria-hidden="true">•</span>{f}</li>)}
					</ul>
				</div>
				<div class="rounded-[24px] bg-band p-7">
					<h2 class="text-[21px] font-semibold tracking-[-0.02em]">Where {competitor} is ahead</h2>
					<ul class="mt-4 space-y-2.5 text-[17px] text-ink-2">
						{theyLead.map((f) => <li class="flex gap-3"><span class="text-ink-3" aria-hidden="true">•</span>{f}</li>)}
					</ul>
				</div>
			</section>

			<section class="prose-g mt-16 text-[19px] leading-relaxed">
				<h2 class={h2}>How to switch from {competitor}</h2>
				<ol class="mt-4 list-decimal space-y-3 pl-6">
					{switching.map((step) => <li>{step}</li>)}
				</ol>
				<p class="mt-4">Setup takes about five minutes. <a class="text-accent hover:underline" href="/start/">Start the setup ›</a></p>
			</section>

			<section class="prose-g mt-16 text-[19px] leading-relaxed">
				<h2 class={h2}>Why net revenue matters</h2>
				<p>
					Payment providers keep a cut of every sale: Stripe's standard US card rate is 2.9% + 30¢, and merchant-of-record platforms take more. Add ad spend, and a channel with $10,000 in sales, $8,000 in ads and $450 in fees made you <strong>$1,550</strong>.
				</p>
				<p>
					Grosslytics ranks channels by <strong>revenue per visitor</strong> after those costs, so you can see which ones actually pay.
				</p>
			</section>

			<section class="mt-16 border-t border-line pt-12">
				<h2 class="text-[28px] font-semibold tracking-[-0.02em]">{competitor} alternative: questions</h2>
				<div class="mt-4 divide-y divide-line">
					{faqs.map((faq) => (
						<details class="group py-5">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[17px] font-semibold">
								<h3>{faq.question}</h3>
								<span class="text-[22px] font-light text-ink-3 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
							</summary>
							<p class="mt-3 text-[17px] leading-relaxed text-ink-2">{faq.answer}</p>
						</details>
					))}
				</div>
			</section>

			<nav aria-label="Other comparisons" class="mt-16">
				<h2 class="text-[21px] font-semibold tracking-[-0.02em]">Other comparisons</h2>
				<ul class="mt-4 grid gap-3 sm:grid-cols-3">
					{related.map((r) => (
						<li><a href={r.href} class="block rounded-2xl bg-band p-4 text-[15px] hover:ring-1 hover:ring-line"><span class="text-ink-3">Grosslytics vs</span><span class="mt-1 block font-semibold">{r.name} ›</span></a></li>
					))}
				</ul>
			</nav>

			<div class="mt-16 rounded-[28px] bg-band p-10 text-center">
				<h2 class="text-[28px] font-semibold tracking-[-0.02em]">See your own numbers.</h2>
				<p class="mt-2 text-ink-2">Free on your Cloudflare account.</p>
				<div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
					<a href="/start/" class="btn btn-primary">Start free</a>
					<a href="/app/demo" class="btn-quiet text-[17px]">Explore the live demo ›</a>
				</div>
			</div>
		</article>
	</main>
</Page>
