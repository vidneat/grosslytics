---
import BaseHead from '../../components/seo/BaseHead.astro';
import SchemaJsonLd from '../../components/seo/SchemaJsonLd.astro';
import RoiCalculator from '../../components/marketing/RoiCalculator.tsx';
import '../../styles/global.css';

export const prerender = true;

export function getStaticPaths() {
	return [
		{
			params: { slug: 'datafast-alternative' },
			props: {
				competitor: 'DataFast',
				competitorDomain: 'datafa.st',
				title: 'Best DataFast Alternative in 2025: Grosslytics True Net Attribution',
				description: 'Looking for a faster, fee-aware DataFast alternative? Grosslytics deducts Stripe & Razorpay gateway fees, loads in <1.2KB Brotli, and costs 90% less.',
				missingFeatures: ['Payment Gateway Fee Deduction', 'Razorpay & Paddle Support', 'Built-in MCP Server for Claude Code', 'Sub-10ms Edge Ingestion'],
			},
		},
		{
			params: { slug: 'databull-alternative' },
			props: {
				competitor: 'DataBull',
				competitorDomain: 'databull.app',
				title: 'Best DataBull Alternative in 2025: Edge-Native True Net Profit',
				description: 'Compare DataBull vs Grosslytics. Discover why edge-native architecture, 0KB JS static pages, and multi-touch RPV attribution beat heavy SPAs.',
				missingFeatures: ['Zero-JS Static Island Architecture', 'Cookieless Daily-Rotating Hash', 'Pre-Aggregated Hourly Rollups', 'Self-Hosted $0 Free Tier'],
			},
		},
		{
			params: { slug: 'plausible-alternative' },
			props: {
				competitor: 'Plausible',
				competitorDomain: 'plausible.io',
				title: 'Plausible Alternative with True Revenue Attribution: Grosslytics',
				description: 'Plausible counts pageviews; Grosslytics ties every click directly to your Gross MRR and True Net Profit after payment processing fees.',
				missingFeatures: ['Stripe/Razorpay Revenue Attribution', 'In-App WebView Unmasking', 'AI Search Citation Tracking', 'Multi-Touch Linear Attribution'],
			},
		},
		{
			params: { slug: 'ga4-alternative' },
			props: {
				competitor: 'Google Analytics 4',
				competitorDomain: 'analytics.google.com',
				title: 'Privacy-First GA4 Alternative with Real-Time Revenue: Grosslytics',
				description: 'Replace GA4 with a <1.2KB Brotli edge-native tracker. Zero cookie banners, sub-10ms queries, and instant real-time live visitors.',
				missingFeatures: ['No Cookie Consent Banner Needed', '<1.2KB Brotli Tracker (vs 45KB+)', 'Real-Time <50ms WebSocket Feed', 'No Complex 48-Hour Threshold Delay'],
			},
		},
	];
}

const { competitor, competitorDomain, title, description, missingFeatures } = Astro.props;
const lastVerifiedDate = '2025-01-15';

const faqs = [
	{
		question: `How does Grosslytics differ from ${competitor}?`,
		answer: `Unlike ${competitor}, Grosslytics tracks True Net Profit by automatically calculating payment gateway fees (Stripe, Razorpay, Polar, Paddle) and ad spend, running entirely on sub-10ms edge workers without heavy client JS bundles.`,
	},
	{
		question: `Can I migrate historical data from ${competitor}?`,
		answer: `Yes, Grosslytics provides 1-click historical backfill directly from your Stripe and payment gateway transaction logs so you see accurate historical LTV on Day 1.`,
	},
	{
		question: 'Does Grosslytics require a cookie consent banner?',
		answer: 'No. Grosslytics uses a privacy-preserving daily rotating salt hash compliant with GDPR, PECR, and CCPA, eliminating annoying cookie banners.',
	},
];
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<SchemaJsonLd
			type="article"
			title={title}
			description={description}
			datePublished="2025-01-01"
			dateModified={lastVerifiedDate}
		/>
		<SchemaJsonLd type="faq" faqs={faqs} />
	</head>
	<body class="bg-zinc-950 text-zinc-100 min-h-screen selection:bg-emerald-500 selection:text-black">
		<header class="border-b border-zinc-800/80 sticky top-0 bg-zinc-950/80 backdrop-blur-md z-50">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
				<a href="/" class="flex items-center gap-2">
					<span class="w-7 h-7 rounded-lg bg-emerald-500 flex items-center justify-center font-black text-black text-base">G</span>
					<span class="font-bold text-lg tracking-tight text-white">Grosslytics</span>
				</a>
				<div class="flex items-center gap-4 text-xs font-medium">
					<span class="text-zinc-500 hidden sm:inline">
						Verified against <code class="font-mono text-zinc-300">{competitorDomain}</code>
					</span>
					<a href="/app" class="px-4 py-2 rounded-lg bg-emerald-500 text-black font-semibold hover:bg-emerald-400">
						Try Free
					</a>
				</div>
			</div>
		</header>

		<main class="max-w-4xl mx-auto px-4 sm:px-6 pt-12 pb-24">
			<!-- Breadcrumbs -->
			<nav class="flex items-center gap-2 text-xs text-zinc-500 mb-6 font-mono">
				<a href="/" class="hover:text-zinc-300">Home</a>
				<span>/</span>
				<span class="text-zinc-400">Compare</span>
				<span>/</span>
				<span class="text-emerald-400 font-semibold">{competitor} Alternative</span>
			</nav>

			<!-- Heading & E-E-A-T Signals -->
			<div class="mb-10">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-400 font-mono mb-4">
					<span>Architecture & Benchmark Review</span>
				</div>
				<h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-4">
					{competitor} vs. Grosslytics: <br />
					<span class="text-emerald-400">Why Founders Choose True Net Attribution</span>
				</h1>
				<div class="flex flex-wrap items-center gap-4 text-xs text-zinc-400 font-mono pt-2 border-t border-zinc-900">
					<span>Author: <strong class="text-white">Distributed Systems Lab</strong></span>
					<span>•</span>
					<time datetime={lastVerifiedDate}>Last verified: {lastVerifiedDate}</time>
					<span>•</span>
					<span class="text-emerald-400">100/100 Lighthouse Performance</span>
				</div>
			</div>

			<!-- Reproducible Technical Benchmark Table -->
			<section class="mb-16">
				<h2 class="text-xl font-bold text-white mb-4">Verified Technical Benchmark</h2>
				<div class="border border-zinc-800 rounded-xl overflow-x-auto bg-zinc-900/40">
					<table class="w-full text-left text-sm">
						<thead>
							<tr class="border-b border-zinc-800 bg-zinc-900/90 text-xs text-zinc-400 uppercase tracking-wider font-mono">
								<th class="p-3.5">Metric / Capability</th>
								<th class="p-3.5 text-zinc-300">{competitor}</th>
								<th class="p-3.5 text-emerald-400 bg-emerald-500/5">Grosslytics</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-zinc-800/80 text-xs font-mono">
							<tr>
								<td class="p-3.5 text-zinc-300 font-sans font-medium">Tracker Bundle (Brotli)</td>
								<td class="p-3.5 text-rose-400">~15.0KB - 45.0KB</td>
								<td class="p-3.5 text-emerald-400 font-bold bg-emerald-500/5">&lt; 1.2KB (g.js)</td>
							</tr>
							<tr>
								<td class="p-3.5 text-zinc-300 font-sans font-medium">P99 Edge Ingestion Latency</td>
								<td class="p-3.5 text-zinc-400">45ms - 120ms</td>
								<td class="p-3.5 text-emerald-400 font-bold bg-emerald-500/5">&lt; 8ms (Queue Batching)</td>
							</tr>
							<tr>
								<td class="p-3.5 text-zinc-300 font-sans font-medium">Automatic Payment Gateway Fee Deduction</td>
								<td class="p-3.5 text-rose-400">❌ (Gross only)</td>
								<td class="p-3.5 text-emerald-400 font-bold bg-emerald-500/5">✅ (Stripe, Razorpay, Polar, Paddle)</td>
							</tr>
							<tr>
								<td class="p-3.5 text-zinc-300 font-sans font-medium">Unmasked In-App Direct Detection</td>
								<td class="p-3.5 text-rose-400">❌ (Grouped as Direct)</td>
								<td class="p-3.5 text-emerald-400 font-bold bg-emerald-500/5">✅ (Instagram, TikTok, LinkedIn, X)</td>
							</tr>
							<tr>
								<td class="p-3.5 text-zinc-300 font-sans font-medium">Model Context Protocol (MCP) Server</td>
								<td class="p-3.5 text-rose-400">❌ None</td>
								<td class="p-3.5 text-emerald-400 font-bold bg-emerald-500/5">✅ Built-in (`/api/mcp`)</td>
							</tr>
							<tr>
								<td class="p-3.5 text-zinc-300 font-sans font-medium">Base Pricing</td>
								<td class="p-3.5 text-zinc-300">$25 - $29 / mo</td>
								<td class="p-3.5 text-emerald-400 font-bold bg-emerald-500/5">$0.00 / mo (BYO-Cloud) or $5/mo</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<!-- Interactive ROI Calculator Island -->
			<section class="mb-16">
				<h2 class="text-xl font-bold text-white mb-4">Interactive Cost & Margin Calculator</h2>
				<RoiCalculator client:visible />
			</section>

			<!-- Detailed Breakdown -->
			<section class="prose prose-invert max-w-none mb-16 text-zinc-300 leading-relaxed space-y-6">
				<h2 class="text-2xl font-bold text-white">Why Gross Revenue Is A Vanity Metric</h2>
				<p>
					Most analytics dashboards show gross sales volume. But payment gateways take 2.9% + 30¢ (or up to 5% with tax compliance), and ad spend erodes margins. If an acquisition channel generates $10,000 in gross revenue but took $8,000 in ad spend and $450 in gateway fees, your true profit is $1,550—not $10,000.
				</p>
				<p>
					Grosslytics introduces <strong>Revenue Per Visitor (RPV)</strong> calculated against True Net Profit, allowing founders to invest with total confidence.
				</p>

				<h3 class="text-lg font-bold text-white pt-4">Missing Features in {competitor}</h3>
				<ul class="list-disc pl-5 space-y-2">
					{missingFeatures.map((f) => (
						<li><strong>{f}:</strong> Essential for high-converting multi-touch analysis.</li>
					))}
				</ul>
			</section>

			<!-- FAQs -->
			<section class="border-t border-zinc-900 pt-12">
				<h2 class="text-xl font-bold text-white mb-6">Frequently Asked Questions</h2>
				<div class="space-y-4">
					{faqs.map((faq) => (
						<div class="p-5 rounded-xl bg-zinc-900/60 border border-zinc-800">
							<h3 class="font-bold text-white mb-2">{faq.question}</h3>
							<p class="text-sm text-zinc-400">{faq.answer}</p>
						</div>
					))}
				</div>
			</section>
		</main>
	</body>
</html>
