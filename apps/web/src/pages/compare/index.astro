---
import type { MarkdownInstance } from 'astro';
import Page from '../../layouts/Page.astro';
const articles = Object.values(import.meta.glob<MarkdownInstance<{title: string; description: string}>>('./*.md', { eager: true }))
    .sort((a, b) => a.frontmatter.title.localeCompare(b.frontmatter.title));
---
<Page title="Compare revenue analytics tools | Grosslytics" description="Compare analytics tools by payment support, hosting, attribution and cost. These comparisons are published by Grosslytics; choose the fit for your requirements.">
    <main class="mx-auto max-w-3xl px-5 py-16">
        <h1 class="text-4xl font-semibold tracking-tight">Compare revenue analytics tools</h1>
        <p class="mt-4 text-ink-2">Compare analytics tools by payment support, hosting, attribution and cost. These comparisons are published by Grosslytics; choose the fit for your requirements.</p>
        <ul class="mt-8">
            {articles.map(article => <li class="border-b border-line py-6">
                <h2 class="text-xl font-semibold"><a class="underline" href={`${article.url}/`}>{article.frontmatter.title}</a></h2>
                <p class="mt-2 text-ink-2">{article.frontmatter.description}</p>
            </li>)}
    <li class="border-b border-line py-6"><h2 class="text-xl font-semibold"><a class="underline" href="/compare/ga4-alternative/">Grosslytics and Google Analytics</a></h2><p class="mt-2 text-ink-2">Compare revenue attribution with general website analytics.</p></li>
        </ul>
    </main>
</Page>
