  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun build src/index.ts --target node --outfile dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@clack/prompts": "^0.9.0",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
