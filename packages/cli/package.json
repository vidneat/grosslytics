{
  "name": "grosslytics",
  "version": "0.1.0",
  "description": "Install Grosslytics in your own Cloudflare (Lifetime license), and the MCP stdio bridge",
  "license": "AGPL-3.0-only",
  "homepage": "https://grosslytics.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vidneat/grosslytics.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "analytics",
    "revenue",
    "attribution",
    "cloudflare",
    "self-hosted",
    "mcp"
  ],
