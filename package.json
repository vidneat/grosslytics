{
  "name": "grosslytics",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "bun test packages apps",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:test-site": "python3 -m http.server 3000 --directory examples/test-site",
    "db:migrate:local": "bun scripts/db.ts migrate",
    "db:seed:local": "bun scripts/db.ts seed",
    "db:migrate:remote": "bun scripts/db.ts migrate-remote",
    "setup": "bun scripts/release.ts --keep-env && bun run --cwd packages/cli build && node packages/cli/dist/index.js install --bundle .release/grosslytics.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
