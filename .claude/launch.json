{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "apps/web",
        "dev"
      ],
      "port": 4321,
      "autoPort": false
    },
    {
      "name": "api",
      "runtimeExecutable": "bunx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8787"
      ],
      "port": 8787,
      "autoPort": false
    },
    {
      "name": "api-cloud",
      "runtimeExecutable": "bunx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8787",
        "--var",
        "CLOUD:1"
      ],
      "port": 8787,
      "autoPort": false
    },
    {
      "name": "api-license",
      "runtimeExecutable": "bunx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8787",
        "--var",
        "LICENSE_SECRET:local-test-only"
      ],
      "port": 8787,
      "autoPort": false
    },
    {
      "name": "test-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3000",
        "--directory",
        "examples/test-site"
      ],
      "port": 3000,
      "autoPort": false
    }
  ]
}